rules_version = '2';

// Catalog images (thumbnails and screenshots).
//
// Known limitation, accepted deliberately: Storage rules cannot read Firestore,
// so the `admins/{uid}` collection used by firestore.rules is not reachable
// here. Upload access is therefore gated on an explicit allowlist of
// administrator email addresses, which must be kept in step with the `admins`
// collection by hand.
//
// Adding an administrator = create admins/{uid} in the console AND add their
// email below, then `firebase deploy --only storage`.
//
// If that becomes tedious, the upgrade path is a custom claim set by a Cloud
// Function; it is not built here because Supply is intentionally serverless.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'sellysimulator@gmail.com'
           ];
    }

    function isCatalogImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif|svg\\+xml)');
    }

    match /games/{gameId}/{fileName} {
      // Catalog images are public so the site can render without auth.
      allow read: if true;
      allow write: if isAdminEmail() && isCatalogImage();
      allow delete: if isAdminEmail();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
