# Supabase project settings — dashboard → Project Settings → API keys.

# Sent to the browser. Vite compiles every VITE_-prefixed variable into the
# public bundle, which is fine for these two: the URL identifies the project,
# and the publishable key carries no privileges of its own. What any caller may
# read or write is decided entirely by the row level security policies in
# supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=