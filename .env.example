# Firebase web app config — Firebase console → Project settings → Your apps → Web app.
# These identifiers are not secrets: access is controlled by Security Rules and
# App Check, not by hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — enables Google Analytics for site traffic, read in the Firebase console.
VITE_FIREBASE_MEASUREMENT_ID=

# App Check. Firebase console → App Check → register the web app with reCAPTCHA v3.
# Required in production: without it the anonymous analytics writes are rejected
# once enforcement is switched on.
VITE_RECAPTCHA_SITE_KEY=

# Local development only. Firebase console → App Check → Apps → Manage debug tokens.
# Generate any UUID, put it here, and register the same value in the console.
VITE_APPCHECK_DEBUG_TOKEN=

# Set to true to run against the local emulator suite instead of the real project.
VITE_USE_EMULATORS=false
