# Local development against the Firebase emulator suite — no real project needed.
#
#   cp .env.emulator .env
#   npm run emulators      # in one terminal
#   npm run seed:emulator  # optional: load scripts/seed-games.json
#   npm run dev            # in another
#
# To work against the real project instead, copy .env.example to .env and fill
# it in. Remember to set VITE_USE_EMULATORS=false, or the app will keep talking
# to the emulator and appear empty.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-supply.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-supply
VITE_FIREBASE_STORAGE_BUCKET=demo-supply.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_EMULATORS=true
